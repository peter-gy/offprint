{
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "target": "ES2023",
    "useDefineForClassFields": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["build.ts", "src/**/*.ts", "tests/**/*.ts"]
}
