{
  "name": "@pageknot/collector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run build.ts",
    "build:check": "bun run build.ts --check",
    "check": "bun build ./src/index.ts --target=browser --format=iife --outfile=/dev/null",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" build.ts package.json tsconfig.json",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" build.ts package.json tsconfig.json",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/bun": "1.3.10",
    "prettier": "3.7.4",
    "typescript": "5.9.3"
  }
}
