{
  "name": "@offprint/collector",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.ts",
    "build:check": "node build.ts --check",
    "format": "oxfmt --config ../.oxfmtrc.json .",
    "format:check": "oxfmt --check --config ../.oxfmtrc.json .",
    "lint": "oxlint --config ../.oxlintrc.json --deny-warnings --report-unused-disable-directives .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "rolldown": "1.2.7",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
