{
  "name": "offprint",
  "version": "0.1.0",
  "description": "Capture rendered web pages as verified self-contained artifacts",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peter-gy/offprint.git",
    "directory": "bindings/node"
  },
  "bugs": {
    "url": "https://github.com/peter-gy/offprint/issues"
  },
  "type": "module",
  "main": "./index.cjs",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.cjs"
    }
  },
  "files": [
    "api.cjs",
    "contracts.generated.d.ts",
    "index.cjs",
    "index.d.ts",
    "index.js",
    "LICENSE",
    "native.cjs",
    "native.d.ts",
    "offprint-native.*.node",
    "README.md"
  ],
  "napi": {
    "packageName": "offprint",
    "binaryName": "offprint-native",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release --no-js --dts native.d.ts",
    "build:debug": "napi build --platform --no-js --dts native.d.ts",
    "build:test": "napi build --platform --no-js --dts ../../target/offprint-node-test.d.ts --features binding-test-hooks",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepack": "node scripts/package-license.mjs sync",
    "postpack": "node scripts/package-license.mjs clean"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.8.6",
    "@types/node": "24.10.3",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1.3.14"
}
