{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VerificationReport",
  "type": "object",
  "properties": {
    "artifactSha256": {
      "type": "string"
    },
    "bytes": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "mode": {
      "$ref": "#/$defs/VerificationMode"
    },
    "networkRequests": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "schemaVersion": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "required": [
    "schemaVersion",
    "mode",
    "artifactSha256",
    "bytes",
    "networkRequests"
  ],
  "$defs": {
    "VerificationMode": {
      "type": "string",
      "enum": [
        "static",
        "offline"
      ]
    }
  }
}
