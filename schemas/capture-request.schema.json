{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CaptureRequest",
  "type": "object",
  "properties": {
    "browser": {
      "$ref": "#/$defs/BrowserSpec"
    },
    "content": {
      "$ref": "#/$defs/ContentPolicy"
    },
    "credentials": {
      "$ref": "#/$defs/CaptureCredentials"
    },
    "diagnostics": {
      "$ref": "#/$defs/DiagnosticsPolicy"
    },
    "environment": {
      "$ref": "#/$defs/BrowserEnvironment"
    },
    "headed": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "limits": {
      "$ref": "#/$defs/CaptureLimits"
    },
    "network": {
      "$ref": "#/$defs/NetworkPolicy"
    },
    "output": {
      "$ref": "#/$defs/CaptureOutput"
    },
    "readiness": {
      "$ref": "#/$defs/ReadinessPolicy"
    },
    "schemaVersion": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "verification": {
      "$ref": "#/$defs/VerificationMode"
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "url",
    "output",
    "browser",
    "environment",
    "readiness",
    "content",
    "network",
    "limits",
    "verification",
    "diagnostics"
  ],
  "$defs": {
    "BrowserCookie": {
      "type": "object",
      "properties": {
        "domain": {
          "type": [
            "string",
            "null"
          ]
        },
        "expires": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "httpOnly": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "name": {
          "type": "string",
          "maxLength": 4096,
          "minLength": 1
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "sameSite": {
          "anyOf": [
            {
              "$ref": "#/$defs/CookieSameSite"
            },
            {
              "type": "null"
            }
          ]
        },
        "secure": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "value": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ]
    },
    "BrowserEnvironment": {
      "type": "object",
      "properties": {
        "colorScheme": {
          "$ref": "#/$defs/ColorScheme"
        },
        "locale": {
          "type": "string"
        },
        "reducedMotion": {
          "$ref": "#/$defs/ReducedMotion"
        },
        "timezone": {
          "type": "string"
        },
        "userAgent": {
          "$ref": "#/$defs/UserAgentPolicy"
        },
        "viewport": {
          "$ref": "#/$defs/Viewport"
        }
      },
      "additionalProperties": false,
      "required": [
        "viewport",
        "locale",
        "timezone",
        "colorScheme",
        "reducedMotion",
        "userAgent"
      ]
    },
    "BrowserSpec": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "auto"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "executable"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "remote"
            },
            "value": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        }
      ]
    },
    "CaptureCredentials": {
      "type": "object",
      "properties": {
        "cookies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BrowserCookie"
          },
          "maxItems": 4096
        },
        "headers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RequestHeader"
          },
          "maxItems": 256
        }
      },
      "additionalProperties": false
    },
    "CaptureLimits": {
      "type": "object",
      "properties": {
        "artifactBytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 1
        },
        "collectorChunkBytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 1
        },
        "concurrentResources": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 1
        },
        "duration": {
          "type": "integer",
          "format": "uint64",
          "minimum": 1
        },
        "frameDepth": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 1
        },
        "frames": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1
        },
        "nodes": {
          "type": "integer",
          "format": "uint64",
          "maximum": 1000000,
          "minimum": 1
        },
        "redirects": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "resourceBytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 1
        },
        "resourceRecursionDepth": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 1
        },
        "resources": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1
        },
        "totalResourceBytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "duration",
        "redirects",
        "frames",
        "nodes",
        "resources",
        "resourceBytes",
        "totalResourceBytes",
        "collectorChunkBytes",
        "concurrentResources",
        "artifactBytes",
        "resourceRecursionDepth",
        "frameDepth"
      ]
    },
    "CaptureOutput": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "conflict": {
              "$ref": "#/$defs/ConflictPolicy"
            },
            "kind": {
              "type": "string",
              "const": "file"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path",
            "conflict"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "memory"
            },
            "maxBytes": {
              "type": "integer",
              "format": "uint64",
              "minimum": 1
            }
          },
          "required": [
            "kind",
            "maxBytes"
          ]
        }
      ]
    },
    "CaptureScope": {
      "type": "string",
      "enum": [
        "page",
        "selection"
      ]
    },
    "ColorScheme": {
      "type": "string",
      "enum": [
        "light",
        "dark"
      ]
    },
    "ConflictPolicy": {
      "type": "string",
      "enum": [
        "fail",
        "replace",
        "uniquify"
      ]
    },
    "ContentPolicy": {
      "type": "object",
      "properties": {
        "allowedFileRoots": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "missingResources": {
          "$ref": "#/$defs/MissingResourcePolicy"
        },
        "optimizations": {
          "$ref": "#/$defs/OptimizationPolicy",
          "default": {
            "removeHiddenElements": false,
            "removeUnusedCss": false,
            "removeUnusedFonts": false
          }
        },
        "preservePasswordValues": {
          "type": "boolean"
        },
        "scope": {
          "$ref": "#/$defs/CaptureScope",
          "default": "page"
        },
        "selector": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "missingResources",
        "preservePasswordValues"
      ]
    },
    "CookieSameSite": {
      "type": "string",
      "enum": [
        "strict",
        "lax",
        "none"
      ]
    },
    "DiagnosticsPolicy": {
      "type": "object",
      "properties": {
        "directory": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "LazyLoadPolicy": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "disabled"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "viewport-sweep"
            },
            "options": {
              "$ref": "#/$defs/ViewportSweepPolicy"
            }
          },
          "required": [
            "kind",
            "options"
          ]
        }
      ]
    },
    "MissingResourcePolicy": {
      "type": "string",
      "enum": [
        "warn",
        "fail"
      ]
    },
    "NetworkPolicy": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "standard"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "server"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "unrestricted"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "custom"
            },
            "rules": {
              "$ref": "#/$defs/NetworkRules"
            }
          },
          "required": [
            "kind",
            "rules"
          ]
        }
      ]
    },
    "NetworkRules": {
      "type": "object",
      "properties": {
        "allowLinkLocal": {
          "type": "boolean",
          "default": false
        },
        "allowLoopback": {
          "type": "boolean",
          "default": false
        },
        "allowPrivate": {
          "type": "boolean",
          "default": false
        },
        "allowedCidrs": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "allowedHosts": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "OptimizationPolicy": {
      "type": "object",
      "properties": {
        "removeHiddenElements": {
          "type": "boolean",
          "default": false
        },
        "removeUnusedCss": {
          "type": "boolean",
          "default": false
        },
        "removeUnusedFonts": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "ReadinessMode": {
      "type": "string",
      "enum": [
        "render-idle",
        "network-idle",
        "load",
        "dom-content-loaded"
      ]
    },
    "ReadinessPolicy": {
      "type": "object",
      "properties": {
        "delay": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "lazyLoad": {
          "$ref": "#/$defs/LazyLoadPolicy"
        },
        "mode": {
          "$ref": "#/$defs/ReadinessMode"
        },
        "mutationQuiet": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "networkQuiet": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "mode",
        "networkQuiet",
        "mutationQuiet",
        "delay",
        "lazyLoad"
      ]
    },
    "ReducedMotion": {
      "type": "string",
      "enum": [
        "reduce",
        "no-preference"
      ]
    },
    "RequestHeader": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ]
    },
    "UserAgentPolicy": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "browser-default"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "override"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        }
      ]
    },
    "VerificationMode": {
      "type": "string",
      "enum": [
        "static",
        "offline"
      ]
    },
    "Viewport": {
      "type": "object",
      "properties": {
        "height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1
        },
        "scale": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 1
        },
        "width": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "scale"
      ]
    },
    "ViewportSweepPolicy": {
      "type": "object",
      "properties": {
        "maxSteps": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "settle": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "stepPixels": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "stepPixels",
        "settle",
        "maxSteps"
      ]
    }
  }
}
