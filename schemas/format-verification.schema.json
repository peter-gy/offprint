{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FormatVerification",
  "type": "object",
  "properties": {
    "bytes": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "format": {
      "$ref": "#/$defs/ArtifactFormat"
    },
    "sha256": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "format",
    "bytes",
    "sha256"
  ],
  "$defs": {
    "ArtifactFormat": {
      "type": "string",
      "enum": [
        "html",
        "pdf",
        "markdown",
        "zip",
        "self-extracting-html",
        "mhtml"
      ]
    }
  }
}
