{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PageObservation",
  "type": "object",
  "properties": {
    "baseUrl": {
      "type": "string"
    },
    "doctype": {
      "type": "string"
    },
    "encoding": {
      "type": "string"
    },
    "finalUrl": {
      "type": "string"
    },
    "frameOwners": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/FrameOwnerObservation"
      }
    },
    "frames": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "html": {
      "type": "string"
    },
    "nodes": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "requestedUrl": {
      "type": "string"
    },
    "selection": {
      "$ref": "#/$defs/SelectionObservation",
      "default": {
        "nodes": 0,
        "ranges": 0
      }
    },
    "subtreeNodes": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "title": {
      "type": "string"
    },
    "viewport": {
      "$ref": "#/$defs/ObservationViewport"
    },
    "visualFallbacks": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/VisualFallback"
      }
    },
    "warnings": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/CollectorWarning"
      }
    }
  },
  "required": [
    "doctype",
    "html",
    "requestedUrl",
    "finalUrl",
    "baseUrl",
    "title",
    "encoding",
    "viewport",
    "frames",
    "nodes",
    "subtreeNodes"
  ],
  "$defs": {
    "CollectorWarning": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "FrameOwnerObservation": {
      "type": "object",
      "properties": {
        "originalPath": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        },
        "retainedPath": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        }
      },
      "required": [
        "originalPath",
        "retainedPath"
      ]
    },
    "ObservationViewport": {
      "type": "object",
      "properties": {
        "deviceScaleFactor": {
          "type": "string"
        },
        "height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "scrollX": {
          "type": "string"
        },
        "scrollY": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "width",
        "height",
        "deviceScaleFactor",
        "scrollX",
        "scrollY"
      ]
    },
    "SelectionObservation": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "ranges": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "ranges",
        "nodes"
      ]
    },
    "VisualFallback": {
      "type": "object",
      "properties": {
        "height": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/VisualFallbackKind"
        },
        "width": {
          "type": "string"
        },
        "x": {
          "type": "string"
        },
        "y": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "x",
        "y",
        "width",
        "height"
      ]
    },
    "VisualFallbackKind": {
      "type": "string",
      "enum": [
        "canvas",
        "video"
      ]
    }
  }
}
