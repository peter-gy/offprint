{
  "browser": {
    "kind": "auto"
  },
  "content": {
    "allowedFileRoots": [],
    "missingResources": "warn",
    "optimizations": {
      "removeHiddenElements": false,
      "removeUnusedCss": false,
      "removeUnusedFonts": false
    },
    "preservePasswordValues": false,
    "scope": "page"
  },
  "diagnostics": {},
  "environment": {
    "colorScheme": "light",
    "locale": "en-US",
    "reducedMotion": "reduce",
    "timezone": "UTC",
    "userAgent": {
      "kind": "browser-default"
    },
    "viewport": {
      "height": 900,
      "scale": 1,
      "width": 1440
    }
  },
  "limits": {
    "artifactBytes": 67108864,
    "collectorChunkBytes": 1048576,
    "concurrentResources": 8,
    "duration": 120000,
    "frameDepth": 64,
    "frames": 256,
    "nodes": 1000000,
    "redirects": 20,
    "resourceBytes": 67108864,
    "resourceRecursionDepth": 64,
    "resources": 10000,
    "totalResourceBytes": 536870912
  },
  "network": {
    "kind": "standard"
  },
  "output": {
    "conflict": "fail",
    "kind": "file",
    "path": "example.html"
  },
  "readiness": {
    "delay": 0,
    "lazyLoad": {
      "kind": "viewport-sweep",
      "options": {
        "maxSteps": 100,
        "settle": 100,
        "stepPixels": 720
      }
    },
    "mode": "render-idle",
    "mutationQuiet": 300,
    "networkQuiet": 500
  },
  "schemaVersion": 2,
  "url": "https://example.com/",
  "verification": "offline"
}
