{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ArtifactExportRequest",
  "type": "object",
  "properties": {
    "baseName": {
      "type": "string"
    },
    "conflict": {
      "$ref": "#/$defs/ConflictPolicy"
    },
    "outputDirectory": {
      "type": "string"
    },
    "variants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ArtifactVariant"
      }
    }
  },
  "required": [
    "outputDirectory",
    "baseName",
    "variants",
    "conflict"
  ],
  "$defs": {
    "ArtifactVariant": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "pdf"
            },
            "options": {
              "$ref": "#/$defs/PdfOptions"
            }
          },
          "required": [
            "kind",
            "options"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "markdown"
            },
            "options": {
              "$ref": "#/$defs/MarkdownOptions"
            }
          },
          "required": [
            "kind",
            "options"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "zip"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "self-extracting"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "mhtml"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "ConflictPolicy": {
      "type": "string",
      "enum": [
        "fail",
        "replace",
        "uniquify"
      ]
    },
    "MarkdownOptions": {
      "type": "object",
      "properties": {
        "frontMatter": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "PdfOptions": {
      "type": "object",
      "properties": {
        "landscape": {
          "type": "boolean",
          "default": false
        },
        "preferCssPageSize": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
