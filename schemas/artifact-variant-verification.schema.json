{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ArtifactVariantVerification",
  "type": "object",
  "properties": {
    "bytes": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "contentValid": {
      "type": "boolean"
    },
    "kind": {
      "$ref": "#/$defs/ArtifactVariantKind"
    },
    "passed": {
      "type": "boolean"
    },
    "sha256": {
      "type": "string"
    },
    "structureValid": {
      "type": "boolean"
    }
  },
  "required": [
    "kind",
    "passed",
    "bytes",
    "sha256",
    "structureValid",
    "contentValid"
  ],
  "$defs": {
    "ArtifactVariantKind": {
      "type": "string",
      "enum": [
        "pdf",
        "markdown",
        "zip",
        "self-extracting",
        "mhtml"
      ]
    }
  }
}
