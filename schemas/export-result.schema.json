{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExportResult",
  "type": "object",
  "properties": {
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ExportedArtifact"
      }
    },
    "capturePolicySha256": {
      "type": "string"
    },
    "resources": {
      "$ref": "#/$defs/ResourceSummary"
    },
    "schemaVersion": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "sourceArtifactSha256": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceArtifactSha256",
    "capturePolicySha256",
    "resources",
    "artifacts"
  ],
  "$defs": {
    "ArtifactFormat": {
      "type": "string",
      "enum": [
        "html",
        "pdf",
        "markdown",
        "zip",
        "self-extracting-html",
        "mhtml"
      ]
    },
    "ExportedArtifact": {
      "type": "object",
      "properties": {
        "bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "entrypoint": {
          "type": "string"
        },
        "format": {
          "$ref": "#/$defs/ArtifactFormat"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "verification": {
          "$ref": "#/$defs/FormatVerification"
        }
      },
      "additionalProperties": false,
      "required": [
        "format",
        "path",
        "entrypoint",
        "bytes",
        "sha256",
        "verification"
      ]
    },
    "FormatVerification": {
      "type": "object",
      "properties": {
        "bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "format": {
          "$ref": "#/$defs/ArtifactFormat"
        },
        "sha256": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "format",
        "bytes",
        "sha256"
      ]
    },
    "ResourceSummary": {
      "type": "object",
      "properties": {
        "discovered": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "embedded": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "embeddedBytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "external": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "omitted": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "discovered",
        "embedded",
        "external",
        "omitted",
        "failed",
        "embeddedBytes"
      ]
    }
  }
}
