{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContentPolicy",
  "type": "object",
  "properties": {
    "allowedFileRoots": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "missingResources": {
      "$ref": "#/$defs/MissingResourcePolicy"
    },
    "optimizations": {
      "$ref": "#/$defs/OptimizationPolicy",
      "default": {
        "removeHiddenElements": false,
        "removeUnusedCss": false,
        "removeUnusedFonts": false
      }
    },
    "preservePasswordValues": {
      "type": "boolean"
    },
    "scope": {
      "$ref": "#/$defs/CaptureScope",
      "default": "page"
    },
    "selector": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "missingResources",
    "preservePasswordValues"
  ],
  "$defs": {
    "CaptureScope": {
      "type": "string",
      "enum": [
        "page",
        "selection"
      ]
    },
    "MissingResourcePolicy": {
      "type": "string",
      "enum": [
        "warn",
        "fail"
      ]
    },
    "OptimizationPolicy": {
      "type": "object",
      "properties": {
        "removeHiddenElements": {
          "type": "boolean",
          "default": false
        },
        "removeUnusedCss": {
          "type": "boolean",
          "default": false
        },
        "removeUnusedFonts": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
