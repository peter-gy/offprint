{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BatchResult",
  "type": "object",
  "properties": {
    "failed": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "outcomes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ScheduledCaptureOutcome"
      }
    },
    "planSha256": {
      "type": "string"
    },
    "resumed": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "schemaVersion": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "succeeded": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "planSha256",
    "outcomes",
    "succeeded",
    "failed",
    "resumed"
  ],
  "$defs": {
    "CaptureArtifact": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "bytes": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "file"
            },
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path",
            "bytes",
            "sha256"
          ]
        },
        {
          "type": "object",
          "properties": {
            "bytes": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "content": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              }
            },
            "kind": {
              "type": "string",
              "const": "bytes"
            },
            "sha256": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "bytes",
            "sha256",
            "content"
          ]
        }
      ]
    },
    "CaptureReceipt": {
      "type": "object",
      "properties": {
        "artifact": {
          "$ref": "#/$defs/CaptureArtifact"
        },
        "captureId": {
          "type": "string"
        },
        "resources": {
          "$ref": "#/$defs/ResourceSummary"
        },
        "schemaVersion": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "source": {
          "$ref": "#/$defs/SourceSummary"
        },
        "timings": {
          "$ref": "#/$defs/CaptureTimings"
        },
        "verification": {
          "$ref": "#/$defs/VerificationReport"
        },
        "warnings": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/CaptureWarning"
          }
        }
      },
      "required": [
        "schemaVersion",
        "captureId",
        "source",
        "artifact",
        "verification",
        "resources",
        "timings"
      ]
    },
    "CaptureTimings": {
      "type": "object",
      "properties": {
        "browser": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "collection": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "commit": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "encoding": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "navigation": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "readiness": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "resources": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "transform": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "validation": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "verification": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "total",
        "validation",
        "browser",
        "navigation",
        "readiness",
        "collection",
        "resources",
        "transform",
        "encoding",
        "verification",
        "commit"
      ]
    },
    "CaptureWarning": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "frameId": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "message": {
          "type": "string"
        },
        "resourceId": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "ErrorStage": {
      "type": "string",
      "enum": [
        "validation",
        "browser",
        "navigation",
        "readiness",
        "collection",
        "resource",
        "transform",
        "encoding",
        "verification",
        "commit",
        "shutdown",
        "internal"
      ]
    },
    "OffprintError": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        },
        "diagnosticsPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/OffprintError"
            },
            {
              "type": "null"
            }
          ]
        },
        "stage": {
          "$ref": "#/$defs/ErrorStage"
        }
      },
      "required": [
        "code",
        "message",
        "stage",
        "retryable"
      ]
    },
    "ResourceSummary": {
      "type": "object",
      "properties": {
        "discovered": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "embedded": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "embeddedBytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "external": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "omitted": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "discovered",
        "embedded",
        "external",
        "omitted",
        "failed",
        "embeddedBytes"
      ]
    },
    "ResumeJobRecord": {
      "description": "Compact terminal state persisted by a resumable scheduler.",
      "type": "object",
      "properties": {
        "artifactPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "artifactSha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "captureId": {
          "type": [
            "string",
            "null"
          ]
        },
        "depth": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/OffprintError"
            },
            {
              "type": "null"
            }
          ]
        },
        "ordinal": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "requestSha256": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ResumeJobStatus"
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        }
      },
      "additionalProperties": false,
      "required": [
        "requestSha256",
        "status"
      ]
    },
    "ResumeJobStatus": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed"
      ]
    },
    "ScheduledCaptureOutcome": {
      "description": "Terminal state for one scheduled capture.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "requestSha256": {
              "type": "string"
            },
            "result": {
              "$ref": "#/$defs/CaptureReceipt"
            },
            "status": {
              "type": "string",
              "const": "succeeded"
            }
          },
          "required": [
            "status",
            "id",
            "requestSha256",
            "result"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "$ref": "#/$defs/OffprintError"
            },
            "id": {
              "type": "string"
            },
            "requestSha256": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "const": "failed"
            }
          },
          "required": [
            "status",
            "id",
            "requestSha256",
            "error"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "record": {
              "$ref": "#/$defs/ResumeJobRecord"
            },
            "status": {
              "type": "string",
              "const": "resumed"
            }
          },
          "required": [
            "status",
            "id",
            "record"
          ]
        }
      ]
    },
    "SourceSummary": {
      "type": "object",
      "properties": {
        "finalUrl": {
          "type": "string"
        },
        "finalUrlSha256": {
          "type": "string"
        },
        "requestedUrl": {
          "type": "string"
        },
        "requestedUrlSha256": {
          "type": "string"
        }
      },
      "required": [
        "requestedUrl",
        "requestedUrlSha256",
        "finalUrl",
        "finalUrlSha256"
      ]
    },
    "VerificationMode": {
      "type": "string",
      "enum": [
        "static",
        "offline"
      ]
    },
    "VerificationReport": {
      "type": "object",
      "properties": {
        "artifactSha256": {
          "type": "string"
        },
        "bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "mode": {
          "$ref": "#/$defs/VerificationMode"
        },
        "networkRequests": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "schemaVersion": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "schemaVersion",
        "mode",
        "artifactSha256",
        "bytes",
        "networkRequests"
      ]
    }
  }
}
