{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VerificationResult",
  "type": "object",
  "properties": {
    "artifactSha256": {
      "type": "string"
    },
    "attemptedUrls": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "bytes": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "frameFailures": {
      "type": "array",
      "default": [],
      "items": {
        "type": "integer",
        "format": "uint64",
        "minimum": 0
      }
    },
    "level": {
      "$ref": "#/$defs/VerificationPolicy"
    },
    "networkRequests": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "pageErrors": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "passed": {
      "type": "boolean"
    },
    "schemaVersion": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "stable": {
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion",
    "level",
    "passed",
    "artifactSha256",
    "bytes",
    "networkRequests",
    "stable"
  ],
  "$defs": {
    "VerificationPolicy": {
      "type": "string",
      "enum": [
        "static",
        "offline"
      ]
    }
  }
}
